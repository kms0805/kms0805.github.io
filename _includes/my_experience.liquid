<div class="cv-section">
  {% for entry in site.data.cv %}
    {% if entry.title == "Experience" %}
      {% for content in entry.contents %}
        <div class="cv-item">
          {% if content.logo %}
            <div class="cv-item__logo">
              {% assign entry_path = content.logo | prepend: '/assets/img/logo/' %}
              {%
                include figure.liquid
                loading="eager"
                path=entry_path
                width="48"
                height="48"
                class="cv-logo-img"
                zoomable=false
                alt=content.logo
              %}
            </div>
          {% endif %}
          <div class="cv-item__body">
            {% if content.title %}
              <div class="cv-item__title">{{ content.title }}</div>
            {% endif %}
            {% if content.institution %}
              <div class="cv-item__sub">
                {% if content.url %}<a href="{{ content.url }}" target="_blank">{{ content.institution }}</a>{% else %}{{ content.institution }}{% endif %}
              </div>
            {% endif %}
            {% if content.Host %}
              <div class="cv-item__detail">
                Host: {% if content.Host.url %}<a href="{{ content.Host.url }}" target="_blank">{{ content.Host.name }}</a>{% else %}{{ content.Host.name }}{% endif %}
              </div>
            {% endif %}
            {% if content.maindescription %}
              <div class="cv-item__date">{{ content.maindescription }}</div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    {% endif %}
  {% endfor %}
</div>
