<div class="cv-section">
  {% for entry in site.data.cv %}
    {% if entry.title == "Education" %}
      {% for content in entry.contents %}
        <div class="cv-item">
          {% if content.logo %}
            <div class="cv-item__logo">
              {% assign entry_path = content.logo | prepend: '/assets/img/logo/' %}
              {%
                include figure.liquid
                loading="eager"
                path=entry_path
                width="36"
                height="36"
                class="cv-logo-img"
                zoomable=false
                alt=content.logo
              %}
            </div>
          {% endif %}
          <div class="cv-item__body">
            <div class="cv-item__title">
              {{ content.title }}{% if content.department %}<span class="cv-item__detail"> · {{ content.department }}</span>{% endif %}
            </div>
            {% if content.institution %}
              <div class="cv-item__sub">
                {% if content.url %}<a href="{{ content.url }}" target="_blank">{{ content.institution }}</a>{% else %}{{ content.institution }}{% endif %}
              </div>
            {% endif %}
          </div>
          {% if content.maindescription %}
            <div class="cv-item__date">{{ content.maindescription }}</div>
          {% endif %}
        </div>
      {% endfor %}
    {% endif %}
  {% endfor %}
</div>
