---
layout: default
---
<div class="post">
  <header class="post-header">
    <!-- Hero: Name + Profile side by side -->
    <div class="about-hero">
      {% if page.profile %}
        <div class="about-hero__photo">
          {% if page.profile.image %}
            {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
            {% assign profile_image_class = 'img-fluid about-avatar' %}
            {% capture sizes %}(min-width: {{site.max_width}}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px) 30vw, 95vw"{% endcapture %}
            <div class="coin coin--loading">
              <div class="coin__front" style="transform: translateZ(1px)">
                {%
                  include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
                  cache_bust=true
                %}
              </div>
              <div class="coin__back" style="transform: rotateY(180deg) translateZ(1px); background-image: url('{{ '/assets/img/logo/mil_logo.png' | relative_url }}')"></div>
            </div>
          {% endif %}
        </div>
      {% endif %}
      <div class="about-hero__info">
        <h1 class="about-name">
          {% if site.title == 'blank' %}
            <span class="first-name">{{ site.first_name }}</span> {{ site.middle_name }}
            {{ site.last_name }}
          {% else %}
            {{ site.title }}
          {% endif %}
        </h1>
        {% if page.social %}
          <div class="about-social">
            <div class="contact-icons">{% include social.liquid %}</div>
          </div>
        {% endif %}
        <p class="desc">{{ page.subtitle }}</p>
      </div>
    </div>
  </header>

  <article>
    <!-- Bio -->
    <div class="about-bio reveal">
      {{ content }}
    </div>

    <div class="section-wave"></div>

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <section class="about-section reveal">
        <h2 class="section-heading">
          <a href="{{ '/news/' | relative_url }}" style="color: inherit">News</a>
        </h2>
        {% include news.liquid limit=true %}
      </section>
      <div class="section-wave"></div>
    {% endif %}

    <!-- Education -->
    <section class="about-section reveal">
      <h2 class="section-heading">
        <a href="{{ '/cv/' | relative_url }}" style="color: inherit">Education</a>
      </h2>
      {% include my_education.liquid %}
    </section>

    <div class="section-wave"></div>

    <!-- Experience -->
    <section class="about-section reveal">
      <h2 class="section-heading">
        <a href="{{ '/cv/' | relative_url }}" style="color: inherit">Experience</a>
      </h2>
      {% include my_experience.liquid %}
    </section>

    <div class="section-wave"></div>

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <section class="about-section reveal">
        <h2 class="section-heading">
          <a href="{{ '/publications/' | relative_url }}" style="color: inherit">Publications</a>
        </h2>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}
  </article>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
  // Coin flip — wait for images, then animate
  var coin = document.querySelector(".coin");
  if (coin) {
    var frontImg = coin.querySelector(".coin__front img");
    var backDiv = coin.querySelector(".coin__back");
    var backSrc = backDiv ? backDiv.style.backgroundImage.replace(/url\(['"]?|['"]?\)/g, "") : "";

    function startCoin() {
      coin.classList.remove("coin--loading");
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          coin.classList.add("coin--entry");
        });
      });
    }

    // Wait for both front img and back background-image to load
    var ready = 0;
    var needed = (frontImg ? 1 : 0) + (backSrc ? 1 : 0);
    if (!needed) { startCoin(); }

    function onReady() {
      ready++;
      if (ready >= needed) startCoin();
    }

    // Front: wait for decode
    if (frontImg) {
      if (frontImg.complete) {
        frontImg.decode ? frontImg.decode().then(onReady).catch(onReady) : onReady();
      } else {
        frontImg.addEventListener("load", function () {
          frontImg.decode ? frontImg.decode().then(onReady).catch(onReady) : onReady();
        });
        frontImg.addEventListener("error", onReady);
      }
    }

    // Back: preload background-image via hidden Image
    if (backSrc) {
      var backImg = new Image();
      backImg.onload = function () {
        backImg.decode ? backImg.decode().then(onReady).catch(onReady) : onReady();
      };
      backImg.onerror = onReady;
      backImg.src = backSrc;
    }

    coin.addEventListener("animationend", function () {
      coin.classList.remove("coin--entry", "coin--spinning");
    });
    coin.addEventListener("mouseenter", function () {
      if (!coin.classList.contains("coin--entry") && !coin.classList.contains("coin--spinning")) {
        coin.classList.add("coin--spinning");
      }
    });
  }

  var reveals = document.querySelectorAll(".reveal");
  if (!reveals.length) return;

  // Mark all as ready (adds opacity:0 + transform)
  reveals.forEach(function (el) { el.classList.add("reveal-ready"); });

  // Stagger reveal for elements already in viewport
  var delay = 0;
  reveals.forEach(function (el) {
    var rect = el.getBoundingClientRect();
    if (rect.top < window.innerHeight + 50) {
      el.style.transitionDelay = delay * 0.1 + "s";
      delay++;
      requestAnimationFrame(function () {
        requestAnimationFrame(function () { el.classList.add("visible"); });
      });
    }
  });

  // Observe off-screen elements
  var observer = new IntersectionObserver(
    function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.08 }
  );

  reveals.forEach(function (el) {
    if (!el.classList.contains("visible")) {
      observer.observe(el);
    }
  });
});
</script>
